def enviar_alerta(asunto, mensaje):
    try:
        sns.publish(
            TopicArn=TOPIC_ARN.strip(),
            Subject=asunto[:100],
            Message=mensaje
        )
        print(f"📨 Alerta enviada exitosamente")
    except Exception as e:
        print(f"❌ Error enviando alerta SNS: {e}")

def get_prefix_ultima_particion(s3_client, bucket, base_prefix):
    prefix = base_prefix
    for _ in range(3):
        resp     = s3_client.list_objects_v2(Bucket=bucket, Prefix=prefix, Delimiter="/")
        prefixes = [p["Prefix"] for p in resp.get("CommonPrefixes", [])]
        if not prefixes:
            break
        prefix = sorted(prefixes)[-1]
    return prefix

def leer_todos_parquet(s3_client, bucket, prefix, cols=None):
    resp     = s3_client.list_objects_v2(Bucket=bucket, Prefix=prefix)
    archivos = [o["Key"] for o in resp.get("Contents", []) if o["Key"].endswith(".parquet")]
    if not archivos:
        print(f"⚠️  No se encontraron parquet en {prefix}")
        return None
    print(f"📦 Leyendo {len(archivos)} archivos parquet...")
    dfs = []
    for key in archivos:
        print(f"   📄 {key.split('/')[-1]}")
        obj    = s3_client.get_object(Bucket=bucket, Key=key)
        buffer = io.BytesIO(obj["Body"].read())
        tabla  = pq.read_table(buffer)
        df     = tabla.to_pandas()
        df.columns = df.columns.str.lower()
        if cols:
            df = df[[c for c in cols if c in df.columns]]
        dfs.append(df)
    df_total = pd.concat(dfs, ignore_index=True)
    print(f"✅ Total leído: {len(df_total):,} filas (con duplicados)\n")
    return df_total

def leer_todas_particiones(s3_client, bucket, base_prefix, cols=None):
    paginator = s3_client.get_paginator("list_objects_v2")
    archivos  = []
    for page in paginator.paginate(Bucket=bucket, Prefix=base_prefix):
        for obj in page.get("Contents", []):
            if obj["Key"].endswith(".parquet"):
                archivos.append(obj["Key"])
    if not archivos:
        print(f"⚠️  No se encontraron parquet en {base_prefix}")
        return None
    print(f"📦 Leyendo {len(archivos)} archivos parquet (todas las particiones)...")
    dfs = []
    for key in archivos:
        obj    = s3_client.get_object(Bucket=bucket, Key=key)
        buffer = io.BytesIO(obj["Body"].read())
        tabla  = pq.read_table(buffer)
        df     = tabla.to_pandas()
        df.columns = df.columns.str.lower()
        if cols:
            df = df[[c for c in cols if c in df.columns]]
        dfs.append(df)
    df_total = pd.concat(dfs, ignore_index=True)
    print(f"✅ Total leído: {len(df_total):,} filas (con duplicados)\n")
    return df_total

# ✅ FUNCIÓN MODIFICADA — duplicado real solo si toda la fila de negocio es igual
def deduplicar_aws(df, clave, clave_compuesta=None):
    antes = len(df)

    # Columnas de metadatos que NO forman parte del dato de negocio
    cols_meta    = [c for c in df.columns if c.startswith('_')]

    # Columnas de negocio = todas menos metadatos
    cols_negocio = [c for c in df.columns if c not in cols_meta]

    # Paso 1: Eliminar duplicados reales (toda la fila de negocio igual)
    df = df.drop_duplicates(subset=cols_negocio, keep="first")

    # Paso 2: Si aún quedan múltiples versiones del mismo ID
    # (mismo ID con distinta fechaactualizacion = actualización legítima)
    # quedarse con la más reciente por _ingestion_timestamp
    cols_dedup = clave_compuesta if clave_compuesta else [clave]
    if "_ingestion_timestamp" in df.columns:
        df = df.sort_values("_ingestion_timestamp", ascending=False)
        df = df.drop_duplicates(subset=cols_dedup, keep="first")

    despues = len(df)
    print(f"✅ Deduplicado: {antes:,} → {despues:,} filas ({antes - despues:,} duplicados eliminados)")
    return df

def filtrar_por_fecha_aws(df, col_fecha_aws, fecha_desde, fecha_hasta):
    if col_fecha_aws is None or col_fecha_aws not in df.columns:
        return df
    try:
        df = df.copy()
        df[col_fecha_aws] = pd.to_datetime(df[col_fecha_aws], errors="coerce")
        if df[col_fecha_aws].dt.tz is not None:
            df[col_fecha_aws] = df[col_fecha_aws].dt.tz_localize(None)
        fecha_desde_dt = pd.Timestamp(fecha_desde)
        fecha_hasta_dt = pd.Timestamp(fecha_hasta + " 23:59:59")
        df_filtrado = df[
            (df[col_fecha_aws] >= fecha_desde_dt) &
            (df[col_fecha_aws] <= fecha_hasta_dt)
        ].copy()
        print(f"✅ Filtro fecha AWS: {len(df):,} → {len(df_filtrado):,} filas")
        return df_filtrado
    except Exception as e:
        print(f"⚠️  Error aplicando filtro de fecha en AWS: {e}")
        return df

def verificar_ids_en_lotes(conn_str, tabla, clave, ids, lote=5000):
    total    = 0
    ids_list = list(ids)
    conn     = pyodbc.connect(conn_str)
    cur      = conn.cursor()
    for i in range(0, len(ids_list), lote):
        bloque  = ids_list[i:i+lote]
        ids_str = ','.join(f"'{x}'" if isinstance(x, str) else str(x) for x in bloque)
        cur.execute(f"SELECT COUNT(*) FROM {tabla} WHERE [{clave}] IN ({ids_str})")
        total += cur.fetchone()[0]
    cur.close()
    conn.close()
    return total

def verificar_clave_compuesta_en_lotes(conn_str, tabla, clave_compuesta, pares, lote=2000):
    total    = 0
    lista    = list(pares)
    conn     = pyodbc.connect(conn_str)
    cur      = conn.cursor()
    col1, col2 = clave_compuesta[0], clave_compuesta[1]
    for i in range(0, len(lista), lote):
        bloque = lista[i:i+lote]
        condiciones = " OR ".join(
            f"([{col1}] = {v1} AND [{col2}] = {v2})"
            for v1, v2 in bloque
        )
        cur.execute(f"SELECT COUNT(*) FROM {tabla} WHERE {condiciones}")
        total += cur.fetchone()[0]
    cur.close()
    conn.close()
    return total

def normalizar(series):
    return series.astype(str).replace({"None": "", "nan": "", "NaN": "", "<NA>": ""})

