                        SELECT {', '.join(select_parts)}
                        FROM {tabla_sql}
                        WHERE [{clave}] IN ({ids_muestra_str})
                    """)

                filas_sql4   = cursor4.fetchall()
                nombres_sql4 = [col[0] for col in cursor4.description]
            
            cursor4.close()
            conn_sql.close()

            df_muestra_sql = pd.DataFrame.from_records(filas_sql4, columns=nombres_sql4)
            df_muestra_sql.columns = df_muestra_sql.columns.str.lower()
            df_muestra_sql[clave] = df_muestra_sql[clave].astype(str)
            df_muestra_aws[clave] = df_muestra_aws[clave].astype(str)
            merge_key = clave

        df_merge = df_muestra_sql.merge(df_muestra_aws, on=merge_key, suffixes=('_sql', '_aws'))

        resumen_cols      = []
        diferencias_total = 0

        if not df_merge.empty:
            print(f"\n{'Columna':<35} {'Diffs':>8} {'% Match':>10}")
            print("-"*55)
            for col in cols_comunes:
                col_sql = f"{col}_sql"
                col_aws = f"{col}_aws"
                if col_sql in df_merge.columns and col_aws in df_merge.columns:
                    diff  = (normalizar(df_merge[col_sql]) != normalizar(df_merge[col_aws])).sum()
                    total = len(df_merge)
                    pct   = round((1 - diff/total)*100, 2) if total > 0 else 100
                    diferencias_total += diff
                    estado = "✅" if diff == 0 else "⚠️ "
                    print(f"{estado} {col:<33} {diff:>8,} {pct:>9}%")
                    resumen_cols.append({
                        "Tabla": nombre, "Columna": col,
                        "Diferencias": diff, "Total": total,
                        "% Match": pct, "Estado": "OK" if diff == 0 else "DIFERENCIA"
                    })
                    if diff > 0:
                        resultado["alertas"].append(f"  - {col}: {diff:,} diffs ({pct}% match)")

            resultado["diff_columnas"] = diferencias_total
            print(f"\nTOTAL diferencias columnas: {diferencias_total:,}")

            nombre_archivo = tabla_aws.replace(".", "_")
            pd.DataFrame(resumen_cols).to_csv(
                f"comparacion_{nombre_archivo}.csv",
                index=False, encoding="utf-8-sig"
            )
            print(f"📁 Exportado: comparacion_{nombre_archivo}.csv")

    except Exception as e:
        print(f"⚠️  Error comparando valores: {e}")
        conn_sql.close()

    return resultado

