def comparar_tabla(cfg):
    nombre            = cfg["nombre"]
    conn_str          = cfg["conn_str"]
    tabla_sql         = cfg["tabla_sql"]
    tabla_aws         = cfg["tabla_aws"]
    s3_prefix         = cfg["s3_prefix"]
    clave             = cfg["clave"]
    clave_compuesta   = cfg.get("clave_compuesta", None)
    col_fecha         = cfg["col_fecha"]
    col_fecha_aws     = cfg["col_fecha_aws"]
    fecha_hasta       = cfg.get("fecha_hasta", FECHA_HASTA)
    todas_particiones = cfg.get("leer_todas_particiones", False)

    print("\n" + "█"*60)
    print(f"  EVALUANDO: {nombre}")
    print("█"*60)

    resultado = {
        "nombre":        nombre,
        "diff_filas":    0,
        "ids_huerfanos": 0,
        "diff_columnas": 0,
        "alertas":       [],
        "error":         None
    }

    # ── LEER AWS ──
    try:
        if todas_particiones:
            print(f"📅 Leyendo todas las particiones desde: {s3_prefix}")
            df_aws = leer_todas_particiones(s3, S3_BUCKET, s3_prefix)
        else:
            prefix = get_prefix_ultima_particion(s3, S3_BUCKET, s3_prefix)
            print(f"📅 Partición: {prefix}")
            df_aws = leer_todos_parquet(s3, S3_BUCKET, prefix)

        if df_aws is None:
            resultado["error"] = "No se encontraron parquet en S3"
            return resultado

        df_aws = deduplicar_aws(df_aws, clave, clave_compuesta)

        if col_fecha_aws:
            df_aws = filtrar_por_fecha_aws(df_aws, col_fecha_aws, FECHA_DESDE, fecha_hasta)

        cols_limpias = [c for c in df_aws.columns
                        if not c.startswith('_') and 'ingestion' not in c]
        df_aws    = df_aws[cols_limpias].copy()
        total_aws = len(df_aws)
        ids_aws   = set(df_aws[clave].dropna().astype(str).tolist())
        print(f"✅ AWS final: {total_aws:,} filas | {len(ids_aws):,} IDs únicos")

    except Exception as e:
        resultado["error"] = str(e)
        return resultado

    # ── LEER SQL SERVER ──
    try:
        conn_sql = pyodbc.connect(conn_str)
        cursor   = conn_sql.cursor()

        cursor.execute(f"SELECT COUNT(*) FROM {tabla_sql}")
        total_sql = cursor.fetchone()[0]

        if col_fecha:
            cursor.execute(f"""
                SELECT COUNT(*) FROM {tabla_sql}
                WHERE [{col_fecha}] >= '{FECHA_DESDE}'
                  AND [{col_fecha}] <= '{fecha_hasta} 23:59:59'
            """)
            total_sql_rango = cursor.fetchone()[0]
        else:
            total_sql_rango = total_sql

        cursor.execute(f"""
            SELECT COLUMN_NAME, DATA_TYPE
            FROM INFORMATION_SCHEMA.COLUMNS
            WHERE TABLE_NAME = '{tabla_sql}'
            ORDER BY ORDINAL_POSITION
        """)
        schema_sql = {row[0]: row[1] for row in cursor.fetchall()}
        cursor.close()

        print(f"✅ SQL Server total : {total_sql:,} filas")
        print(f"✅ SQL Server rango : {total_sql_rango:,} filas")

    except Exception as e:
        resultado["error"] = str(e)
        conn_sql.close()
        return resultado

    # ── COMPARACIÓN GENERAL ──
    diff_filas = abs(total_sql_rango - total_aws)
    resultado["diff_filas"] = diff_filas

    print(f"\n{'Métrica':<30} {'SQL (rango)':>12} {'AWS (dedup)':>12}")
    print("-"*55)
    print(f"{'Total filas':<30} {total_sql_rango:>12,} {total_aws:>12,}")
    print(f"{'IDs únicos AWS':<30} {'':>12} {len(ids_aws):>12,}")
    print(f"{'Diferencia':<30} {diff_filas:>12,}")

    # ── VERIFICACIÓN DE IDs ──
    if len(ids_aws) == 0:
        print("⚠️  AWS no tiene registros en el rango — omitiendo verificación de IDs")
        resultado["alertas"].append("  AWS sin registros en el rango de fechas")
    elif clave_compuesta:
        pares = list(zip(
            df_aws[clave_compuesta[0]].astype(int),
            df_aws[clave_compuesta[1]].astype(int)
        ))
        total_encontrados = verificar_clave_compuesta_en_lotes(conn_str, tabla_sql, clave_compuesta, pares)
        ids_huerfanos     = len(pares) - total_encontrados
        resultado["ids_huerfanos"] = ids_huerfanos

        print(f"Pares en AWS       : {len(pares):,}")
        print(f"Pares en SQL Server: {total_encontrados:,}")
        print(f"Pares sin match    : {ids_huerfanos:,}")

        if ids_huerfanos == 0:
            print("✅ Todos los pares de AWS existen en SQL Server")
        else:
            print(f"⚠️  {ids_huerfanos:,} pares NO están en SQL Server")
            resultado["alertas"].append(f"  Pares sin match: {ids_huerfanos:,}")
    else:
        # En caso de AvanceVentas esto podría demorar por los 13M de registros, pero lo mantenemos
        # tal cual solicitaste que el resto del código quede intacto. 
        total_encontrados = verificar_ids_en_lotes(conn_str, tabla_sql, clave, ids_aws)
        ids_huerfanos     = len(ids_aws) - total_encontrados
        resultado["ids_huerfanos"] = ids_huerfanos

        print(f"IDs en AWS         : {len(ids_aws):,}")
        print(f"IDs en SQL Server  : {total_encontrados:,}")
        print(f"IDs sin match      : {ids_huerfanos:,}")

        if ids_huerfanos == 0:
            print("✅ Todos los IDs de AWS existen en SQL Server")
        else:
            print(f"⚠️  {ids_huerfanos:,} IDs NO están en SQL Server")
            resultado["alertas"].append(f"  IDs sin match: {ids_huerfanos:,}")

    # ── COMPARACIÓN DE VALORES ──
    if len(ids_aws) == 0:
        print("⚠️  Sin registros AWS en el rango — omitiendo comparación de valores")
        return resultado

    print(f"\n🔬 Comparando valores (muestra {MUESTRA} registros)...")

    df_muestra_aws = df_aws.head(MUESTRA).copy()

    sql_col_map  = {k.lower(): k for k in schema_sql.keys()}
